{
    "version": "10.0.0",
    "publicReleaseRefSpec": [
        "^refs/heads/main$", // main publishes the version above: a -runic.{height} line or a stable release
        "^refs/heads/release/\\d+\\.x$" // release/<major>.x branches publish stable packages
    ],
    "nugetPackageVersion": {
        "semVer": 2
    },
    "cloudBuild": {
        "setVersionVariables": true,
        "buildNumber": {
            "enabled": false
        }
    }
}
