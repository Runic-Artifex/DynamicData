<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Runic Artifex fork of DynamicData for .NET 10 and System.Reactive</Title>
    <Description>The Runic Artifex fork of DynamicData for .NET 10 and System.Reactive, via ReactiveUI.Primitives.Reactive. Dynamic Data brings the power of Rx to collections: domain-centric observable caches and lists whose LINQ operators enable dynamic filtering, sorting, grouping, transforms, binding, pagination, data virtualisation, expiration and disposal management.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>RunicArtifex.DynamicData.Reactive</PackageId>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.Primitives.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Reactive" />
    <Using Include="System.Reactive.Concurrency" />
    <Using Include="System.Reactive.Disposables" />
    <Using Include="System.Reactive.Linq" />
    <Using Include="System.Reactive.Subjects" />
    <Using Include="System.Reactive.Threading.Tasks" />
    <Using Include="ReactiveUI.Primitives.Reactive.LinqExtensions" Alias="PrimitivesLinqExtensions" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals" />
    <Using Include="System.Reactive.Unit" Alias="Unit" />
    <Using Include="System.Reactive.Concurrency.IScheduler" Alias="IScheduler" />
    <Using Include="System.Reactive.Concurrency.Scheduler" Alias="Scheduler" />
    <Using Include="System.Reactive.Concurrency.TaskPoolScheduler" Alias="TaskPoolScheduler" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DynamicData\**\*.cs" Exclude="..\DynamicData\bin\**;..\DynamicData\obj\**" LinkBase="DynamicData" />
    <Compile Update="..\DynamicData\**\ObservableCacheEx.*.cs">
      <DependentUpon>ObservableCacheEx.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- AsyncDisposeMany is only supported on platforms that have IAsyncDisposable. -->
  <ItemGroup Condition="!$(DefineConstants.Contains('SUPPORTS_ASYNC_DISPOSABLE'))">
    <Compile Remove="..\DynamicData\Cache\ObservableCacheEx.AsyncDisposeMany.cs" />
  </ItemGroup>
</Project>
