<?xml version="1.0" encoding="utf-8"?>

<Project>
  <!-- Runic: this file stops the search for a Directory.Packages.props, so an enclosing
       SDK workspace's central versions never apply to the fork. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ReactiveUIPrimitivesVersion (Directory.Build.props) selects Primitives 9.0.0 or 8.4.0 compatibility. -->
  <ItemGroup>
    <!-- Referenced from Directory.Build.props, not as a GlobalPackageReference: that would drop the
         buildTransitive targets SourceLink needs to embed the repository commit in packages. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="$(ReactiveUIPrimitivesVersion)" />
  </ItemGroup>

  <!--
    Floating versions are allowed only in test and benchmark projects. NuGet rejects any floating PackageVersion visible to a
    project without CentralPackageFloatingVersionsEnabled, so these versions are hidden from the shipped library entirely.
  -->
  <PropertyGroup Condition="$(IsTestProject) OR $(IsBenchmarkProject)">
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup Condition="$(IsTestProject) OR $(IsBenchmarkProject)">
    <PackageVersion Include="BenchmarkDotNet" Version="*" />
    <PackageVersion Include="Bogus" Version="35.*" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="PublicApiGenerator" Version="11.*" />
    <PackageVersion Include="TUnit" Version="1.68.4" />
  </ItemGroup>

  <!-- Build tooling and analyzers, referenced by every matching project as private assets -->
  <ItemGroup>
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.10.91" />
  </ItemGroup>
  <ItemGroup Condition="!$(IsTestProject) AND !$(IsBenchmarkProject)">
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
</Project>
