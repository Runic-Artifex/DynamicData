<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RunicDynamicDataVersion Condition="'$(RunicDynamicDataVersion)' == ''">0.0.0-unset</RunicDynamicDataVersion>
    <ReactiveUIPrimitivesVersion Condition="'$(ReactiveUIPrimitivesVersion)' == ''">9.0.0</ReactiveUIPrimitivesVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Acceptance.cs" Link="Acceptance.cs" />
  </ItemGroup>
</Project>
