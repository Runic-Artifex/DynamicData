<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(UseReactive)' == 'true'">$(DefineConstants);REACTIVE_BENCHMARK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/DynamicData/DynamicData.csproj" Condition="'$(UseReactive)' != 'true'" />
    <ProjectReference Include="../../../src/DynamicData.Reactive/DynamicData.Reactive.csproj" Condition="'$(UseReactive)' == 'true'" />
  </ItemGroup>
</Project>
